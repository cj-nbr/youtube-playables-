---
const tabs = [
  { id: "home", label: "Home", href: "/playables?isApp=true&platform=android&source=app", icon: "home" },
  { id: "games", label: "Games", href: "/playables?isApp=true&platform=android&source=app", icon: "games" },
  { id: "profile", label: "Profile", href: "/profile?isApp=true&platform=android&source=app", icon: "profile" },
];
---

<nav class="ytp-app-bottom-nav fixed inset-x-0 bottom-0 z-50 hidden border-t border-hairline bg-canvas/95 backdrop-blur-md safe-bottom" style="padding-bottom: env(safe-area-inset-bottom);">
  <div class="mx-auto flex max-w-[1400px] items-center justify-around">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class="flex flex-col items-center gap-1 py-2 text-xs text-body hover:text-ink"
        data-nav-tab={tab.id}
      >
        <span class="text-base leading-none">{tab.icon === "home" ? "🏠" : tab.icon === "games" ? "🎮" : "👤"}</span>
        <span>{tab.label}</span>
      </a>
    ))}
  </div>
</nav>

<script is:inline>
  (() => {
    try {
      const params = new URLSearchParams(window.location.search);
      const isApp = params.get('isApp') === 'true';
      if (isApp) {
        const nav = document.querySelector('.ytp-app-bottom-nav');
        if (nav) nav.classList.remove('hidden');
      }
    } catch {}
  })();
</script>
