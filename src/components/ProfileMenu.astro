---
import { authService } from "../lib/auth/auth-service";
---

<div id="profile-menu-container" class="relative">
  <button
    id="profile-menu-btn"
    type="button"
    aria-label="Profile menu"
    aria-expanded="false"
    class="flex h-8 w-8 items-center justify-center rounded-full bg-canvas-soft text-ink transition-colors hover:bg-canvas-hover"
  >
    {(() => {
      const { user, loading } = authService.getState();
      if (loading) {
        return <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A10 10 0 1118.9 12m-1.17 3.602a4 4 0 11-7.47 0 4 4 0 017.47 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 01-3 3" /></svg>;
      }
      if (user?.avatar_url) {
        return <img src={user.avatar_url} alt="Avatar" class="h-full w-full rounded-full object-cover" />;
      }
      return <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A10 10 0 1118.9 12m-1.17 3.602a4 4 0 11-7.47 0 4 4 0 017.47 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 01-3 3" /></svg>;
    })()}
  </button>

  <div
    id="profile-menu-panel"
    class="absolute right-0 top-full mt-2 w-72 rounded-xl border border-hairline bg-canvas shadow-[0_1px_1px_#00000005,0_2px_2px_#0000000a] opacity-0 invisible transition-all duration-200 z-50"
  >
    <div id="profile-menu-content"></div>
  </div>
</div>

<script type="module">
  (() => {
    const btn = document.getElementById("profile-menu-btn");
    const panel = document.getElementById("profile-menu-panel");
    const content = document.getElementById("profile-menu-content");
    if (!btn || !panel || !content) return;

    let isOpen = false;
    let currentUser = null;
    let authService = null;

    import("../lib/auth/auth-service.ts").then((mod) => {
      authService = mod.authService;
    });

    const updateUser = () => {
      if (!authService) return;
      const state = authService.getState();
      currentUser = state.user;
    };

    const render = () => {
      if (!currentUser) {
        content.innerHTML = `
          <div class="p-4 space-y-3">
            <p class="text-sm text-body">Sign in to track progress and save scores.</p>
            <div class="space-y-2">
              <a href="/signup" class="flex items-center justify-center rounded-pill bg-ink px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">Sign Up</a>
              <a href="/login" class="flex items-center justify-center rounded-pill border border-hairline px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-hover transition-colors">Log In</a>
            </div>
          </div>
        `;
        return;
      }

      const initials = (currentUser.full_name || currentUser.name || "U").charAt(0).toUpperCase();
      const avatarHtml = currentUser.avatar_url
        ? `<img src="${currentUser.avatar_url}" alt="Avatar" class="h-12 w-12 rounded-full object-cover border-2 border-[#007cf0]" />`
        : `<div class="h-12 w-12 rounded-full bg-gradient-to-br from-[#007cf0] to-[#00dfd8] flex items-center justify-center text-white text-lg font-semibold border-2 border-[#007cf0]">${initials}</div>`;

      content.innerHTML = `
        <div class="p-4 border-b border-hairline">
          <div class="flex items-center gap-3">
            ${avatarHtml}
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink truncate">${currentUser.full_name || currentUser.name || "Player"}</p>
              <p class="text-xs text-body truncate">${currentUser.email || currentUser.phone || ""}</p>
            </div>
          </div>
        </div>
        <div class="p-2">
          <a href="/profile" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-ink hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#007cf0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            Profile
          </a>
          <a href="/profile/achievements" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-ink hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#007cf0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
            Achievements
          </a>
          <a href="/profile/details" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-ink hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#007cf0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Profile Details
          </a>
          <a href="/profile/security" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-ink hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#007cf0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            Security
          </a>
        </div>
        <div class="p-2 border-t border-hairline">
          <button id="logout-btn" class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-red-500 hover:bg-red-500/10 transition-colors text-left">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            Log Out
          </button>
        </div>
      `;

      const logoutBtn = content.querySelector("#logout-btn");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", async () => {
          await authService.signOut();
          window.location.href = "/";
        });
      }
    };

    const toggle = () => {
      isOpen = !isOpen;
      if (isOpen) {
        updateUser();
        render();
        panel.classList.remove("opacity-0", "invisible");
        panel.classList.add("opacity-100", "visible");
        btn.setAttribute("aria-expanded", "true");
      } else {
        panel.classList.add("opacity-0", "invisible");
        panel.classList.remove("opacity-100", "visible");
        btn.setAttribute("aria-expanded", "false");
      }
    };

    btn.addEventListener("click", toggle);
    document.addEventListener("click", (e) => {
      if (!btn.contains(e.target as Node) && !panel.contains(e.target as Node)) {
        if (isOpen) toggle();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) toggle();
    });
  })();
</script>
