---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AppBottomNav from "../components/AppBottomNav.astro";
import type { GameMeta } from "../shared/types";
import { SITE_URL, SITE_NAME, SITE_TWITTER } from "../shared/config";

interface Props {
 title?: string;
 description?: string;
 game?: GameMeta;
 /** Absolute or root-relative canonical URL override (e.g. /blog/slug). */
 canonical?: string;
 /** Open Graph / Twitter image (absolute URL or root-relative path). */
 ogImage?: string;
 /** "website" | "article" — controls og:type. Defaults to website. */
 ogType?: string;
 /** Extra JSON-LD schema objects to inject (Article, FAQPage, etc.). */
 jsonLd?: Record<string, unknown>[];
}

const {
  title = "Playables",
  description = "Playables — free playables.",
 game,
 canonical,
 ogImage,
 ogType = "website",
 jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname;
const isPlayables = path === "/playables";
const isBlog = path.startsWith("/blog");
const isArticle = isBlog && !path.endsWith("/blog");

const pageUrl = canonical ? (canonical.startsWith("http") ? canonical : SITE_URL + canonical) : SITE_URL + path;
const ogImg = ogImage ? (ogImage.startsWith("http") ? ogImage : SITE_URL + ogImage) : `${SITE_URL}/images/articles/default-cover.svg`;

const orgLd = {
 "@context": "https://schema.org",
 "@type": "Organization",
 name: SITE_NAME,
 url: SITE_URL,
 logo: `${SITE_URL}/favicon.svg`,
 description: "Free browser-native HTML5 games.",
};

const websiteLd = {
 "@context": "https://schema.org",
 "@type": "WebSite",
 name: SITE_NAME,
 url: SITE_URL,
 description: "Free browser-native HTML5 games.",
 potentialAction: {
  "@type": "SearchAction",
  target: `${SITE_URL}/search?q={search_term_string}`,
  "query-input": "required name=search_term_string",
 },
};

const collectionPageLd = isPlayables
 ? {
   "@context": "https://schema.org",
   "@type": "CollectionPage",
   name: "Playables",
   description: "A growing library of quick, free, browser-native playables.",
   url: `${SITE_URL}/playables`,
   isPartOf: { "@type": "WebSite", name: SITE_NAME, url: SITE_URL },
  }
 : null;

const webPageLd = !game && (isBlog || path === "/about" || path === "/contact" || path === "/privacy" || path === "/terms")
 ? {
   "@context": "https://schema.org",
   "@type": "WebPage",
   name: title,
   description,
   url: `${SITE_URL}${path}`,
   isPartOf: { "@type": "WebSite", name: SITE_NAME, url: SITE_URL },
  }
 : null;
---

<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

   <script is:inline>
    (() => {
     try {
      const stored = localStorage.getItem("ytp:theme");
      const dark = stored !== null ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
      const params = new URLSearchParams(window.location.search);
      if (params.get('isApp') === 'true') {
        document.documentElement.classList.add('ytp-app');
      }
     } catch {}
    })();
   </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>

  {game && <Seo game={game} />}

  {!game && (
   <>
    <link rel="canonical" href={pageUrl} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#171717" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE_TWITTER} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
   </>
  )}

  {jsonLd.map((ld, i) => (
   <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} data-schema={i}></script>
  ))}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
   href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"
   rel="stylesheet"
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>
  {collectionPageLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionPageLd)}></script>}
  {webPageLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageLd)}></script>}
 </head>
  <body>
   <SiteHeader />
   <slot />
   <Footer />
   <AppBottomNav />
  </body>
</html>

