---
import Layout from "../layouts/Layout.astro";
import { SITE_NAME, SITE_URL } from "../shared/config";

const title = "Return & Refund Policy";
const description = "Details on subscription plans, refund eligibility, and how to request a refund for Playables app services.";
---

<Layout title={title} description={description}>
  <div class="mx-auto max-w-[1400px] px-4 py-12 sm:py-16">
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl mb-4">
        Return &amp; Refund Policy
      </h1>
      <p class="text-sm text-mute">
        Last updated: August 7, 2026
      </p>
    </header>

    <div class="prose prose-lg max-w-none">
      <p>
        Our platform provides digital subscription services. By purchasing a subscription, users agree to the following refund policy.
      </p>

      <h2>Subscription Plans</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <li class="border border-hairline rounded-xl p-6 bg-canvas hover:shadow-md transition-shadow">
          <strong class="block font-medium text-ink mb-1">Basic Plan</strong>
          <span class="text-sm text-body">$0.90 for 1 day</span>
        </li>
        <li class="border border-hairline rounded-xl p-6 bg-canvas hover:shadow-md transition-shadow">
          <strong class="block font-medium text-ink mb-1">Intermediate Plan</strong>
          <span class="text-sm text-body">$18 for 30 days</span>
        </li>
        <li class="border border-hairline rounded-xl p-6 bg-canvas hover:shadow-md transition-shadow">
          <strong class="block font-medium text-ink mb-1">Premium Plan</strong>
          <span class="text-sm text-body">$54 for 12 months</span>
        </li>
      </ul>

      <h2>Refund Eligibility</h2>
      <ul class="space-y-3 list-disc pl-6">
        <li>Users may request a cancellation and full refund <strong>within 2 calendar days</strong> of the original purchase date.</li>
        <li>Refund requests submitted after the 2-day refund window will <strong>not</strong> be approved.</li>
        <li>From the <strong>3rd day onward</strong>, all purchases are considered final and non-refundable.</li>
        <li>Once a refund is approved, the associated subscription must be immediately deactivated and access to premium features revoked.</li>
      </ul>

      <h2>How to Request a Refund</h2>
      <p>
        Users must contact us through our <a href="/contact" class="text-link font-medium">Contact Us</a> page and include:
      </p>
      <ul class="space-y-3 list-disc pl-6">
        <li>Registered email address</li>
        <li>Order/Payment ID</li>
        <li>Subscription plan purchased</li>
        <li>Reason for requesting the refund</li>
      </ul>

      <h2>Refund Processing</h2>
      <ul class="space-y-3 list-disc pl-6">
        <li>Approved refunds will be processed to the original payment method.</li>
        <li>Processing time depends on the payment provider and financial institution.</li>
      </ul>

      <h2>Non-Refundable Situations</h2>
      <p>Refunds will not be provided if:</p>
      <ul class="space-y-3 list-disc pl-6">
        <li>The request is made after the 2-day refund period.</li>
        <li>The subscription has expired.</li>
        <li>The user violates the Terms of Service.</li>
        <li>Fraudulent or abusive activity is detected.</li>
      </ul>

      <h2>Contact</h2>
      <p>
        For all refund requests or questions, users should use the
        <a href="/contact" class="text-link font-medium">Contact Us</a> page available on the website.
      </p>
    </div>

    <hr class="my-12 border-t border-hairline border-canvas-soft" />

    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-ink mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <details class="bg-canvas border border-hairline rounded-xl p-4 open:bg-canvas-soft transition-colors">
          <summary class="cursor-pointer font-medium text-ink flex items-center gap-2">
            How do I request a refund?
          </summary>
          <p class="mt-2 text-sm text-body">
            Contact us through the <a href="/contact" class="text-link">Contact Us</a> page with your email, payment ID, plan type, and reason for refund.
          </p>
        </details>

        <details class="bg-canvas border border-hairline rounded-xl p-4 open:bg-canvas-soft transition-colors">
          <summary class="cursor-pointer font-medium text-ink flex items-center gap-2">
            How long does a refund take?
          </summary>
          <p class="mt-2 text-sm text-body">
            Refunds are processed within 3-5 business days after approval. Final posting time depends on your payment provider.
          </p>
        </details>

        <details class="bg-canvas border border-hairline rounded-xl p-4 open:bg-canvas-soft transition-colors">
          <summary class="cursor-pointer font-medium text-ink flex items-center gap-2">
            Can I cancel after 2 days?
          </summary>
          <p class="mt-2 text-sm text-body">
            After the 2-day refund window, all purchases are final and non-refundable.
          </p>
        </details>

        <details class="bg-canvas border border-hairline rounded-xl p-4 open:bg-canvas-soft transition-colors">
          <summary class="cursor-pointer font-medium text-ink flex items-center gap-2">
            Where can I contact support?
          </summary>
          <p class="mt-2 text-sm text-body">
            Use the <a href="/contact" class="text-link">Contact Us</a> page on our website for all refund requests and questions.
          </p>
        </details>
      </div>
    </section>

    <footer class="mt-12 pt-6 border-t border-hairline border-canvas-soft">
      <p class="text-sm text-mute">
        © {new Date().getFullYear()} {SITE_NAME}. All rights reserved.
      </p>
    </footer>
  </div>
</Layout>