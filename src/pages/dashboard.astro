---
import Layout from "../layouts/Layout.astro";
import { authService } from "../../lib/auth/auth-service.ts";

---
<Layout title="My Profile - YOUTUBE PLAYABLES" description="Your profile, achievements, and personal settings">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12 contnet">
    <div class="mx-auto max-w-2xl bg-canvas p-8 rounded-xl shadow-[0_1px_1px_#00000005,0_2px_2px_#0000000a]">
      <div class="py-8">
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bold text-ink mb-3">My Account</h1>
          <p class="text-body text-lg text-slate-300">Manage your account, progress, and achievements</p>
        </div>

        <div class="container mx-auto px-4 py-12">
          <div class="grid semi-transparent-grow lg:grid-cols-3 gap-6">
            <div class="bg-canvas text-center rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="relative h-24 w-24 mx-auto">
                <img 
                  src="/avatars/default-avatar.png" 
                  alt="Profile" 
                  class="w-full h-full rounded-full object-cover cursor-pointer hover:scale-105"
                />
              </div>
              <h2 class="mt-4 text-xl font-medium text-ink">{authService.getState().user?.full_name || authService.getState().user?.username || ''}</h2>
              <p class="mt-1 text-sm text-slate-400">
                {authService.getState().user?.email || '.'}
              </p>
            </div>
            
            <div class="bg-canvas text-center rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="space-y-3">
                <p class="text-base font-medium text-ink">Statistics</p>
                <div class="flex justify-center items-center space-x-3">
                  <div class="flex flex-col items-center">
                    <span class="text-red-500 text-6xl font-bold">6</span>
                    <span class="text-slate-400 text-sm">Games</span>
                  </div>
                  <div class="flex flex-col items-center">
                    <span class="text-red-500 text-6xl font-bold">1245</span>
                    <span class="text-slate-400 text-sm">Points</span>
                  </div>
                  <div class="flex flex-col items-center">
                    <span class="text-red-500 text-6xl font-bold">55</span>
                    <span class="text-slate-400 text-sm">Levels</span>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="bg-canvas text-center rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="space-y-4">
                <p class="text-base font-medium text-ink">Achievements</p>
                <div class="flex items-start">
                  <div class="flex-1 mx-3 min-h-16 h-full flex items-center">
                    <div class="flex items-center">
                      <div class="w-5 h-5 rounded-full bg-blue-500 flex items-center justify-center">
                        <span class="text-white text-xs font-medium">3</span>
                      </div>
                      <span class="ml-1 text-sm text-slate-400">Newbie</span>
                    </div>
                  </div>
                  <div class="flex-1 mx-3 min-h-16 h-full flex items-center">
                    <div class="flex items-center">
                      <div class="w-5 h-5 rounded-full bg-blue-500 flex items-center justify-center">
                        <span class="text-white text-xs font-medium">12</span>
                      </div>
                      <span class="ml-1 text-sm text-slate-400">Completed Tasks</span>
                    </div>
                  </div>
                  <div class="flex-1 mx-3 min-h-16 h-full flex items-center">
                    <div class="flex items-center">
                      <div class="w-5 h-5 rounded-full bg-blue-500 flex items-center justify-center">
                        <span class="text-white text-xs font-medium">5</span>
                      </div>
                      <span class="ml-1 text-sm text-slate-400">Invites</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="bg-canvas rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow mt-12">
            <div class="space-y-4">
              <p class="text-base font-medium text-ink mb-2">Security Settings</p>
              <div class="flex flex-col space-y-2">
                <button class="flex items-center gap-2 w-full text-left p-3 bg-canvas-border rounded-lg hover:bg-canvas-border hover:bg-opacity-75 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 mt-0.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V9m-5-4h3Z" />
                  </svg>
                  <span>Current Secret Code:</span>
                  <span class="ml-2 text-sm text-slate-400 truncate">
                    {authSettings.token || '**********'}
                  </span>
                </button>
                <button class="flex items-center gap-2 w-full text-left p-3 bg-canvas-border rounded-lg hover:bg-canvas-border hover:bg-opacity-75 transition-colors text-red-600 hover:text-red-800">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 3a2 2 0 012 2v10.55a.5.5 0 01-.236 0.971l-2.34 1.69a1 1 0 01-.802-.281h-1.42a1 1 0 01-0.951-0.719L3 12.5V5a1 1 0 011-1h14z" />
                  </svg>
                  <span>Change Secret Code</span>
                </button>
                <button class="flex items-center gap-2 w-full text-left p-3 bg-canvas-border rounded-lg hover:bg-canvas-border hover:bg-opacity-75 transition-colors text-red-600 hover:text-red-800">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 3a2 2 0 012 2v10.55a.5.5 0 01-.236.971l-2.34 1.69a1 1 0 01-.802-.281h-1.42a1 1 0 01-0.951-0.719L3 12.5V5a1 1 0 011-1h14z" />
                  </svg>
                  <span>Change Secret Code</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>