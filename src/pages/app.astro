---
import AppLayout from "../layouts/AppLayout.astro";
import AppBottomNav from "../components/AppBottomNav.astro";
import { games, popularGames, newGames } from "../shared/games";
import { gameCover } from "../shared/utils";
---

<AppLayout title="Playables App" description="Playables mobile app interface">
  <div class="ytp-app-page min-h-screen">
    <!-- App Header -->
    <div class="app-header sticky top-0 z-40 border-b border-hairline bg-canvas/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-[1400px] items-center justify-between px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-ink">Playables</span>
        </div>
        <div id="app-header-profile" class="flex items-center gap-2">
        </div>
      </div>
    </div>

    <!-- App Content -->
    <main class="px-4 py-6 pb-24">
      <!-- Home Tab -->
      <section id="tab-home" class="app-tab">
        <h2 class="text-xl font-semibold text-ink mb-4">Continue Playing</h2>
        <div id="recent-games" class="grid gap-3 mb-8">
          <p class="text-sm text-body">No recent games yet. Start playing!</p>
        </div>

        <h2 class="text-xl font-semibold text-ink mb-4">Popular Games</h2>
        <div class="grid gap-3">
          {popularGames(6).map((game) => (
            <a href={`/${game.id}?isApp=true&platform=android&source=app`} class="card card-hover flex items-center gap-3 p-3">
              <div class="h-14 w-20 rounded-lg overflow-hidden bg-canvas-soft-2 flex-shrink-0">
                <img src={gameCover(game.id)} alt={game.title} class="h-full w-full object-cover" loading="lazy" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-ink truncate">{game.title}</h3>
                <p class="text-xs text-body truncate mt-0.5">{game.genre.slice(0, 2).join(", ")}</p>
              </div>
              <span class="text-xs font-medium text-link">Play</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Games Tab -->
      <section id="tab-games" class="app-tab hidden">
        <h2 class="text-xl font-semibold text-ink mb-4">All Games</h2>
        <div class="grid gap-3">
          {games.map((game) => (
            <a href={`/${game.id}?isApp=true&platform=android&source=app`} class="card card-hover flex items-center gap-3 p-3">
              <div class="h-14 w-20 rounded-lg overflow-hidden bg-canvas-soft-2 flex-shrink-0">
                <img src={gameCover(game.id)} alt={game.title} class="h-full w-full object-cover" loading="lazy" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-ink truncate">{game.title}</h3>
                <p class="text-xs text-body truncate mt-0.5">{game.genre.slice(0, 2).join(", ")}</p>
              </div>
              <span class="text-xs font-medium text-link">Play</span>
            </a>
          ))}
        </div>
      </section>

<!-- Shop Tab -->
      <section id="tab-shop" class="app-tab hidden">
        <div id="shop-content">
          <div class="bg-canvas rounded-xl border border-hairline p-6 text-center">
            <div class="inline-block h-8 w-8 animate-spin rounded-full border-2 border-[#007cf0] border-t-transparent"></div>
            <p class="mt-4 text-body">Coming Soon — Shop</p>
          </div>
        </div>
      </section>

      <!-- Profile Tab - redirects to /profile page -->
      <section id="tab-profile" class="app-tab hidden">
        <div id="profile-content">
          <div class="card p-6 text-center">
            <p class="text-sm text-body">Loading profile…</p>
          </div>
        </div>
      </section>
    </main>

    <AppBottomNav />
  </div>

  <script is:inline>
    (function() {
      try {
        const params = new URLSearchParams(window.location.search);
        const isApp = params.get('isApp') === 'true';
        if (!isApp) return;

        const tabs = document.querySelectorAll('.app-tab');
        const initialTab = params.get('tab');
        if (initialTab) {
          tabs.forEach(tab => tab.classList.add('hidden'));
          const target = document.getElementById('tab-' + initialTab);
          if (target) {
            target.classList.remove('hidden');
            if (initialTab === 'profile') {
              window.location.href = '/profile?isApp=true&source=app';
            }
          }
        }
      } catch (err) {
        console.error('[App Navigation]', err);
      }
    })();
  </script>
</AppLayout>