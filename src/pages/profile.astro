---
import Layout from "../layouts/Layout.astro";
import { authService } from "../lib/auth/auth-service";
const { user } = authService.getState();
const loading = !user && !authService.isLoggedIn();
---

<Layout title="My Profile - YOUTUBE PLAYABLES" description="Your profile, achievements, and personal settings">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mx-auto max-w-2xl bg-canvas p-8 rounded-xl shadow-[0_1px_1px_#00000005,0_2px_2px_#0000000a]">
      <div class="py-8">
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bold text-ink mb-3">My Account</h1>
          <p class="text-body text-lg text-slate-300">
            {loading ? "Loading..." : user?.name || user?.username || user?.email || "Welcome back!"}
          </p>
        </div>

        <nav class="space-y-4">
          <a href="/profile/details" class="flex items-center gap-3 w-full text-left p-3 rounded-lg hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 12h14M5 16h14" />
            </svg>
            <span class="text-base font-medium text-ink">Profile Details</span>
          </a>

          <a href="/profile/achievements" class="flex items-center gap-3 w-full text-left p-3 rounded-lg hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5a1 1 0 110 2H9a1 1 0 010-2h5zm0 4-6 6v2h12v-2l-6-6z" />
            </svg>
            <span class="text-base font-medium text-ink">Achievements</span>
          </a>

          <a href="/profile/statistics" class="flex items-center gap-3 w-full text-left p-3 rounded-lg hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6M9 5v6m12 0v6m-6-6v6m6-6H9" />
            </svg>
            <span class="text-base font-medium text-ink">Statistics</span>
          </a>

          <a href="/profile/security" class="flex items-center gap-3 w-full text-left p-3 rounded-lg hover:bg-canvas-hover transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6M9 9a1 1 0 012 0v2a1 1 0 002 0v-2a1 1 0 012 0M9 9v2a3 3 0 006 0V9h-6z" />
            </svg>
            <span class="text-base font-medium text-ink">Security Settings</span>
          </a>
        </nav>

        <div class="mt-12 flex justify-center">
          <a href="/login" class="px-6 py-2 rounded-lg bg-gradient-to-r from-[#007cf0] to-[#00dfd8] text-white hover:opacity-90 transition-opacity">
            <span class="text-sm">Sign Out</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>