---
import Layout from "../../layouts/Layout.astro";
import { authService } from "../../lib/auth/auth-service";
const { user, loading } = authService.getState();

const memberSince = user?.created_at ? new Date(user.created_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : "N/A";
const lastLogin = user?.last_login ? new Date(user.last_login).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "N/A";
---

<Layout title="Profile Details — YOUTUBE PLAYABLES" description="Manage your personal profile information and preferences">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
    <div id="profile-root">
    {loading ? (
      <div class="mx-auto max-w-3xl py-20 text-center">
        <div class="inline-block h-8 w-8 animate-spin rounded-full border-2 border-[#007cf0] border-t-transparent"></div>
        <p class="mt-4 text-body">Loading...</p>
      </div>
    ) : !user ? (
      <div class="mx-auto max-w-3xl py-20 text-center">
        <h1 class="text-3xl font-bold text-ink mb-4">Please log in</h1>
        <p class="text-body mb-6">You need to be logged in to view profile details.</p>
        <a href="/login" class="inline-flex rounded-pill bg-ink px-6 py-2 text-sm font-medium text-white hover:opacity-90">Log In</a>
      </div>
    ) : (
      <div class="mx-auto max-w-3xl space-y-6">
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-ink">Profile Details</h1>
          <p class="mt-2 text-body">Manage your personal information and account details</p>
        </div>

        <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8">
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0">
              <div class="h-24 w-24 rounded-full bg-gradient-to-br from-[#007cf0] to-[#00dfd8] flex items-center justify-center text-white text-3xl font-bold overflow-hidden">
                {user?.avatar_url ? (
                  <img src={user.avatar_url} alt="Avatar" class="h-full w-full object-cover" />
                ) : (
                  (user?.full_name || user?.name || "U").charAt(0).toUpperCase()
                )}
              </div>
            </div>
            <div class="flex-1 space-y-4">
              <div>
                <label class="block text-sm font-medium text-body mb-1">Full Name</label>
                <p class="text-ink font-medium">{user?.full_name || user?.name || "Not set"}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-body mb-1">Email</label>
                <p class="text-ink font-medium">{user?.email || "Not set"}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-body mb-1">Phone Number</label>
                <p class="text-ink font-medium">{user?.phone || "Not set"}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-body mb-1">Unique User Code</label>
                <div class="flex items-center gap-2">
                  <p class="text-ink font-mono font-medium text-lg">{user?.unique_user_code || "------"}</p>
                  <button onclick={async () => { if (user?.unique_user_code) { await navigator.clipboard.writeText(user.unique_user_code); alert("Copied!"); } }} class="text-xs text-[#007cf0] hover:text-[#00dfd8]">Copy</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8">
          <h2 class="text-lg font-semibold text-ink mb-4">Account Information</h2>
          <div class="space-y-3">
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Member Since</span>
              <span class="text-sm text-ink font-medium">{memberSince}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Last Login</span>
              <span class="text-sm text-ink font-medium">{lastLogin}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Current Level</span>
              <span class="text-sm text-ink font-medium">{user?.current_level || 1}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Games Played</span>
              <span class="text-sm text-ink font-medium">{user?.games_played || 0}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Highest Score</span>
              <span class="text-sm text-ink font-medium">{(user?.highest_score || 0).toLocaleString()}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Achievements</span>
              <span class="text-sm text-ink font-medium">{user?.achievements_count || 0}</span>
            </div>
            <div class="flex justify-between py-3 border-b border-hairline">
              <span class="text-sm text-body">Rank</span>
              <span class="text-sm text-ink font-medium">{user?.player_rank || "Bronze"}</span>
            </div>
            <div class="flex justify-between py-3">
              <span class="text-sm text-body">Play Time</span>
              <span class="text-sm text-ink font-medium">{Math.floor((user?.total_play_time || 0) / 60)}h {(user?.total_play_time || 0) % 60}m</span>
            </div>
          </div>
        </div>

        <div class="flex justify-between">
          <a href="/profile" class="text-sm text-[#007cf0] hover:text-[#00dfd8] transition-colors">← Back to Profile</a>
          <a href="/profile/edit" class="text-sm text-[#007cf0] hover:text-[#00dfd8] transition-colors">Edit Profile →</a>
        </div>
      </div>
    )}
    </div>
  </main>

  <script type="module">
    import { authService } from "../../lib/auth/auth-service.js";

    const root = document.getElementById("profile-root");
    if (root) {
      const unsubscribe = authService.subscribe((state) => {
        if (!state.loading) {
          if (!state.user) {
            window.location.href = "/login";
          }
        }
      });
    }
  </script>
</Layout>
