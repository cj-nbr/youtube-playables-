---
import Layout from "../../layouts/Layout.astro";
import { authService } from "../../lib/auth/auth-service";
const { user } = authService.getState();
const loading = !user && !authService.isLoggedIn();
---

<Layout title="My Profile Details - YOUTUBE PLAYABLES" description="Manage your personal profile information and preferences">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mx-auto max-w-3xl bg-canvas p-8 rounded-xl shadow-[0_1px_1px_#00000005,0_2px_2px_#0000000a]">
      <div class="py-8">
        <div class="flex flex-col md:flex-row justify-between items-center mb-8">
          <div class="text-center md:text-left">
            <h1 class="text-4xl font-bold text-ink mb-3">Profile Details</h1>
            <p class="text-body text-lg text-slate-300">
              Manage your personal information and account details
            </p>
          </div>
          <div class="mt-4 md:mt-0">
            <div class="w-20 h-20 rounded-full bg-gradient-to-r from-[#007cf0] to-[#00dfd8] flex items-center justify-center text-white text-2xl font-bold">
              {user?.name?.charAt(0).toUpperCase() || user?.email?.charAt(0).toUpperCase() || "U"}
            </div>
          </div>
        </div>

        <form class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="fullName" class="block text-sm font-medium text-ink">Full Name</label>
              <input 
                type="text" 
                id="fullName" 
                value={user?.name || ""} 
                class="w-full px-4 py-2 rounded-lg bg-canvas-border text-ink border border-hairline focus:border-[#007cf0] focus:outline-none"
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="block text-sm font-medium text-ink">Email Address</label>
              <input 
                type="email" 
                id="email" 
                value={user?.email || ""} 
                class="w-full px-4 py-2 rounded-lg bg-canvas-border text-ink border border-hairline focus:border-[#007cf0] focus:outline-none"
                disabled
              />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="phone" class="block text-sm font-medium text-ink">Phone Number</label>
              <input 
                type="tel" 
                id="phone" 
                value={user?.phone || ""} 
                class="w-full px-4 py-2 rounded-lg bg-canvas-border text-ink border border-hairline focus:border-[#007cf0] focus:outline-none"
                placeholder="+1 (555) 000-0000"
              />
            </div>
            <div class="space-y-2">
              <label for="avatar" class="block text-sm font-medium text-ink">Profile Avatar</label>
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-full bg-gradient-to-r from-[#007cf0] to-[#00dfd8] flex items-center justify-center text-white">
                  A
                </div>
                <button type="button" class="px-4 py-2 rounded-lg bg-canvas-border text-ink hover:bg-canvas-hover transition-colors">
                  Change Avatar
                </button>
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-hairline">
            <h2 class="text-xl font-semibold text-ink mb-4">Account Statistics</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="bg-canvas-border p-4 rounded-lg text-center">
                <div class="text-2xl font-bold text-[#007cf0]">1245</div>
                <div class="text-sm text-slate-400">Total Points</div>
              </div>
              <div class="bg-canvas-border p-4 rounded-lg text-center">
                <div class="text-2xl font-bold text-[#007cf0]">55</div>
                <div class="text-sm text-slate-400">Levels Reached</div>
              </div>
              <div class="bg-canvas-border p-4 rounded-lg text-center">
                <div class="text-2xl font-bold text-[#007cf0]">12</div>
                <div class="text-sm text-slate-400">Achievements</div>
              </div>
              <div class="bg-canvas-border p-4 rounded-lg text-center">
                <div class="text-2xl font-bold text-[#007cf0]">6</div>
                <div class="text-sm text-slate-400">Games Played</div>
              </div>
            </div>
          </div>

          <div class="pt-6 flex justify-end space-x-4">
            <button type="button" class="px-6 py-2 rounded-lg bg-canvas-border text-ink hover:bg-canvas-hover transition-colors">
              Cancel
            </button>
            <button type="submit" class="px-6 py-2 rounded-lg bg-gradient-to-r from-[#007cf0] to-[#00dfd8] text-white hover:opacity-90 transition-opacity">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>