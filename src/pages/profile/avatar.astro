---
import Layout from "../../layouts/Layout.astro";
import { authService } from "../../lib/auth/auth-service";
const { user, loading } = authService.getState();

const avatars = [
 { name: "Robot", src: "/avatars/gaming/robot.svg" },
 { name: "Knight", src: "/avatars/gaming/knight.svg" },
 { name: "Wizard", src: "/avatars/gaming/wizard.svg" },
 { name: "Samurai", src: "/avatars/gaming/samurai.svg" },
 { name: "Ninja", src: "/avatars/gaming/ninja.svg" },
 { name: "Cyberpunk", src: "/avatars/gaming/cyberpunk.svg" },
 { name: "Astronaut", src: "/avatars/gaming/astronaut.svg" },
 { name: "Alien", src: "/avatars/gaming/alien.svg" },
 { name: "Dragon", src: "/avatars/gaming/dragon.svg" },
 { name: "Pixel Hero", src: "/avatars/gaming/pixel-hero.svg" },
 { name: "Girl Gamer", src: "/avatars/gaming/girl-gamer.svg" },
 { name: "Pirate", src: "/avatars/gaming/pirate.svg" },
 { name: "Mage", src: "/avatars/gaming/mage.svg" },
 { name: "Viking", src: "/avatars/gaming/viking.svg" },
 { name: "Fox", src: "/avatars/gaming/fox.svg" },
 { name: "Wolf", src: "/avatars/gaming/wolf.svg" },
 { name: "Cat", src: "/avatars/gaming/cat.svg" },
 { name: "Panda", src: "/avatars/gaming/panda.svg" },
 { name: "Space Soldier", src: "/avatars/gaming/space-soldier.svg" },
 { name: "Arcade Character", src: "/avatars/gaming/arcade-character.svg" },
];
---

<Layout title="Choose Avatar — PLAYABLES" description="Select your gaming avatar">
 <a href="#main" class="skip-link">Skip to content</a>
 <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
  <div id="auth-loading" style={{ display: loading ? 'block' : 'none' }}>
   <div class="mx-auto max-w-2xl py-20 text-center">
    <div class="inline-block h-8 w-8 animate-spin rounded-full border-2 border-[#007cf0] border-t-transparent"></div>
    <p class="mt-4 text-body">Loading...</p>
   </div>
  </div>
  <div id="auth-login" style={{ display: !loading && !user ? 'block' : 'none' }}>
   <div class="mx-auto max-w-2xl py-20 text-center">
    <h1 class="text-3xl font-bold text-ink mb-4">Please log in</h1>
    <p class="text-body mb-6">You need to be logged in to choose an avatar.</p>
    <a href="/login" class="inline-flex rounded-pill bg-ink px-6 py-2 text-sm font-medium text-white hover:opacity-90">Log In</a>
   </div>
  </div>
  <div id="auth-content" style={{ display: !loading && user ? 'block' : 'none' }}>
    <div class="mb-8">
     <h1 class="text-3xl font-bold text-ink">Choose Your Avatar</h1>
     <p class="mt-2 text-body">Select a gaming avatar that represents you.</p>
    </div>

    <div id="avatar-message" class="mb-6 hidden">
     <div id="avatar-message-text" class="rounded-lg p-4 text-sm"></div>
    </div>

    <div class="bg-canvas rounded-xl border border-hairline p-6 mb-6">
     <div class="flex items-center gap-4">
      <div id="avatar-preview" class="h-20 w-20 rounded-full bg-gradient-to-br from-[#007cf0] to-[#00dfd8] flex items-center justify-center text-white text-2xl font-bold overflow-hidden">
       <span id="avatar-preview-letter">U</span>
       <img id="avatar-preview-img" src="" alt="Selected avatar" class="h-full w-full object-cover hidden" />
      </div>
      <div>
       <h2 class="text-lg font-semibold text-ink">Current Avatar</h2>
       <p class="text-sm text-body">Click an avatar below to change it.</p>
      </div>
     </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4" id="avatar-grid">
     {avatars.map((avatar) => (
      <button
       type="button"
       data-avatar-src={avatar.src}
       data-avatar-name={avatar.name}
       class="avatar-choice relative flex flex-col items-center gap-3 rounded-xl border-2 p-4 transition-all hover:scale-105 border-hairline hover:border-[#007cf0]/50"
      >
       <div class="h-16 w-16 rounded-full bg-gradient-to-br from-[#007cf0] to-[#00dfd8] flex items-center justify-center overflow-hidden">
        <img src={avatar.src} alt={avatar.name} class="h-full w-full object-cover" />
       </div>
       <span class="text-xs font-medium text-ink">{avatar.name}</span>
       <span class="avatar-check absolute top-2 right-2 h-5 w-5 rounded-full bg-[#007cf0] flex items-center justify-center hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
       </span>
      </button>
     ))}
    </div>

    <div class="mt-8 flex justify-between">
     <a href="/profile" class="text-sm text-[#007cf0] hover:text-[#00dfd8] transition-colors">← Back to Profile</a>
    </div>
  </div>
 </main>

 <script type="module">
  import { authService } from "../../lib/auth/auth-service.js";

  const setAuthVisibility = (state) => {
   const loadingEl = document.getElementById("auth-loading");
   const loginEl = document.getElementById("auth-login");
   const contentEl = document.getElementById("auth-content");
   if (loadingEl) loadingEl.style.display = state.loading ? "block" : "none";
   if (loginEl) loginEl.style.display = !state.loading && !state.user ? "block" : "none";
   if (contentEl) contentEl.style.display = !state.loading && state.user ? "block" : "none";
   if (!state.loading && !state.user) {
    window.location.href = "/login";
   }
  };

  setAuthVisibility(authService.getState());
  const unsubscribe = authService.subscribe(setAuthVisibility);

  const currentAvatar = authService.getState().user?.avatar_url || "";
  const previewImg = document.getElementById("avatar-preview-img");
  const previewLetter = document.getElementById("avatar-preview-letter");
  const avatarGrid = document.getElementById("avatar-grid");
  const messageBox = document.getElementById("avatar-message");
  const messageText = document.getElementById("avatar-message-text");

  function showMessage(text, type) {
   messageBox.classList.remove("hidden");
   messageText.textContent = text;
   messageText.className = `rounded-lg p-4 text-sm ${type === "error" ? "bg-red-500/10 text-red-500 border border-red-500/20" : "bg-green-500/10 text-green-500 border border-green-500/20"}`;
  }

  function updatePreview(src) {
   if (previewImg && previewLetter) {
    if (src) {
     previewImg.src = src;
     previewImg.classList.remove("hidden");
     previewLetter.classList.add("hidden");
    } else {
     previewImg.classList.add("hidden");
     previewLetter.classList.remove("hidden");
    }
   }
  }

  function updateSelectedAvatar(src) {
   if (!avatarGrid) return;
   avatarGrid.querySelectorAll(".avatar-choice").forEach((btn) => {
    const btnSrc = btn.getAttribute("data-avatar-src");
    const check = btn.querySelector(".avatar-check");
    if (btnSrc === src) {
     btn.classList.add("border-[#007cf0]", "bg-[#007cf0]/5");
     btn.classList.remove("border-hairline", "hover:border-[#007cf0]/50");
     if (check) check.classList.remove("hidden");
    } else {
     btn.classList.remove("border-[#007cf0]", "bg-[#007cf0]/5");
     btn.classList.add("border-hairline", "hover:border-[#007cf0]/50");
     if (check) check.classList.add("hidden");
    }
   });
  }

  updatePreview(currentAvatar);
  updateSelectedAvatar(currentAvatar);

  if (avatarGrid) {
   avatarGrid.addEventListener("click", async (e) => {
    const btn = e.target.closest("button[data-avatar-src]");
    if (!btn) return;
    const src = btn.getAttribute("data-avatar-src");
    if (!src) return;

    updateSelectedAvatar(src);
    updatePreview(src);

    try {
     await authService.updateProfile({ avatar_url: src });
     showMessage("Avatar updated successfully!", "success");
     setTimeout(() => {
      window.location.href = "/profile";
     }, 1200);
    } catch (err) {
     showMessage(err instanceof Error ? err.message : "Failed to update avatar", "error");
    }
   });
  }
 </script>
</Layout>

