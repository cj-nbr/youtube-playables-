---
import Layout from "../../layouts/Layout.astro";
import { authService } from "../../lib/auth/auth-service";
const { user } = authService.getState();
const loading = !user && !authService.isLoggedIn();

const achievements = [
  { id: 1, title: "First Game", desc: "Complete your first game", icon: "⭐", unlocked: true, date: "2024-01-15" },
  { id: 2, title: "Score Master", desc: "Score over 1000 points in a single game", icon: "🏆", unlocked: true, date: "2024-02-20" },
  { id: 3, title: "Daily Streak", desc: "Play 7 games in a row (daily)", icon: "🔥", unlocked: false, progress: "3/7" },
  { id: 4, title: "Perfect Score", desc: "Complete a game without any mistakes", icon: "✨", unlocked: true, date: "2024-03-10" },
  { id: 5, title: "Level Climber", desc: "Reach level 25", icon: "📈", unlocked: false, progress: "15/25" },
  { id: 6, title: "Speed Demon", desc: "Complete 5 games under 30 seconds", icon: "⚡", unlocked: false, progress: "2/5" },
];
---

<Layout title="My Achievements - YOUTUBE PLAYABLES" description="View your achievements, progress, and earned rewards">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mx-auto bg-canvas p-8 rounded-xl shadow-[0_1px_1px_#00000005,0_2px_2px_#0000000a]">
      <div class="py-8">
        <div class="flex flex-col md:flex-row justify-between items-center mb-8">
          <div class="text-center md:text-left">
            <h1 class="text-4xl font-bold text-ink mb-3">My Achievements</h1>
            <p class="text-body text-lg text-slate-300">
              {achievements.filter(a => a.unlocked).length} of {achievements.length} achievements unlocked
            </p>
          </div>
          <div class="mt-4 md:mt-0">
            <div class="text-center">
              <div class="text-4xl mb-1">🏆</div>
              <div class="text-sm text-slate-400">{Math.round((achievements.filter(a => a.unlocked).length / achievements.length) * 100)}% Complete</div>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {#each achievements as a}
            <div class={`p-6 rounded-xl border ${a.unlocked ? 'border-[#007cf0] bg-gradient-to-br from-[#007cf0]/5 to-[#00dfd8]/5' : 'border-hairline bg-canvas-border'}`}>
              <div class="text-center mb-4">
                <div class="text-4xl mb-2">{a.icon}</div>
                <h3 class="font-semibold text-lg text-ink">{a.title}</h3>
              </div>
              <p class="text-sm text-slate-400 text-center mb-4">{a.desc}</p>
              {#if a.unlocked}
                <div class="text-center">
                  <span class="text-xs text-[#007cf0]">Unlocked on {a.date}</span>
                </div>
              {:else}
                <div class="text-center">
                  <span class="text-xs text-slate-500">{a.progress}</span>
                </div>
              {/if}
            </div>
          {/each}
        </div>

        <div class="mt-8 text-center">
          <a href="/profile" class="text-sm text-[#007cf0] hover:text-[#00dfd8] transition-colors">
            ← Back to Profile
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>