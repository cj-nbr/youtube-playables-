---
import Layout from "../layouts/AppLayout.astro";
---

<Layout title="Shop — PLAYABLES">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="mx-auto max-w-[1400px] px-6 py-12">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="text-5xl font-bold tracking-tight text-ink sm:text-6xl">Shop</h1>
      <p class="mt-4 text-lg text-body">
        Premium features and exclusive items coming soon!
      </p>
      <div class="mt-12 py-20 text-center text-body">
        <div class="mx-auto max-w-2xl">
          <div class="inline-block h-8 w-8 animate-spin rounded-full border-2 border-[#007cf0] border-t-transparent"></div>
          <p class="mt-4 text-body">Shop coming soon — stay tuned!</p>
        </div>
      </div>
    </div>
  </main>
</Layout>